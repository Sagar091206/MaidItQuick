# Copy this file to .env, then fill your own values. Never share or commit .env.
MYSQL_URL=jdbc:mysql://localhost:3306/makeitquick?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password

# This creates the first admin once. Use a unique password of at least 12 characters.
APP_ADMIN_NAME=MaidItQuick Admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Keep disabled until an email provider is configured.
MAIL_ENABLED=false
MAIL_FROM=no-reply@your-domain.in

# Optional: choose a secure location outside the public web folder in production.
KYC_UPLOAD_DIRECTORY=uploads/kyc

# ---- Security ----
# HS256 signing secret for the customer JWT issued by /api/v1/auth.
# Must be at least 32 characters in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_DAYS=30

# Customer OTP policy (unified /api/v1/auth flow).
OTP_EXPIRY_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=4
OTP_SEND_WINDOW_MINUTES=10

# SMS delivery. Keep false for local development: OTPs are logged and echoed
# back as devOtp so the flow can be tested without a provider. Set true once a
# real SmsSender integration exists.
SMS_ENABLED=false

# Optional HTTPS. Point SSL_KEYSTORE at a PKCS12 keystore when enabled.
SSL_ENABLED=false
SSL_KEYSTORE=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12

# Optional overrides.
PORT=8080
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
